NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/daadd

# Auth — JWT_SECRET is REQUIRED in production (boot fails without it, spec §9).
# Access tokens default to 1h; clients renew via POST /auth/refresh.
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# QR redemption signing (falls back to JWT_SECRET when unset)
QR_SIGNING_SECRET=

# Redemption economics
TOKEN_VALUE=0.05
MAX_DISCOUNT_PCT=0.15
QR_EXPIRY_SECONDS=120

# CORS: comma-separated allow-list. Production blocks cross-origin requests when unset.
CORS_ORIGINS=http://localhost:3000

# URLs (password-reset links, future OAuth redirect URIs)
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Email: Resend (dev exposes inline dev tokens when unset)
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# Ops alerting (Phase 7): critical backend failures (payment webhook errors,
# scheduled-scan failures) email here, throttled per-subject. Logs when unset.
OPS_ALERT_EMAIL=
OPS_ALERT_THROTTLE_MS=600000

# AI creative generation
ANTHROPIC_API_KEY=

# Platform OAuth (spec §8.3) — required once platform adapters are implemented
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_OAUTH_APP_ID=
META_OAUTH_APP_SECRET=
TIKTOK_OAUTH_CLIENT_ID=
TIKTOK_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
PINTEREST_OAUTH_CLIENT_ID=
PINTEREST_OAUTH_CLIENT_SECRET=
# AES-256-GCM key for encrypting platform tokens at rest (future)
ENCRYPTION_SECRET=

# Payments (Phase 4) — real money via a licensed PSP. DAADD never holds funds.
# Provider abstraction: PSP_PROVIDER selects the adapter (only 'paystack' today).
# Payments are INERT until PAYSTACK_SECRET_KEY is set (endpoints return 503), a
# deliberate gate so nothing charges before live keys AND the Ghanaian
# settlement-structure legal sign-off are in place. In production with
# PAYMENTS_ENABLED=true the secret must be set (server fails fast otherwise).
PSP_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYMENTS_CURRENCY=GHS
# Advertiser billing setup charge, in minor units (pesewas). 5000 = GH₵50.00
BILLING_SETUP_MINOR=5000
# Explicit off-switch even if a key is present (set to 'false' to disable).
PAYMENTS_ENABLED=
# Where Paystack returns the browser after checkout (frontend origin).
PUBLIC_WEB_URL=https://daadd.vercel.app

# Storage provider: cloudinary | s3 | local (see src/services/storage.service.ts).
# Auto-detects when unset: Cloudinary if its keys are set, then S3, else local.
STORAGE_PROVIDER=cloudinary

# Cloudinary (default provider — keyless maps use Leaflet, but creatives use this)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true
# Optional upload folder (defaults to daadd/creatives)
CLOUDINARY_FOLDER=daadd/creatives

# S3 (alternative — activates only when these are set AND @aws-sdk/client-s3 is installed)
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Redis — reserved for future queues/cache; the live server does not require it
REDIS_HOST=localhost
REDIS_PORT=6379

# Seeding — never seed in production unless explicitly enabled
# SEED_DATABASE=false
